# Базовый URL трекера Keitaro без /admin_api/v1 (например https://tracker.example.com)
KEITARO_BASE_URL=https://tracker.example.com
# API-ключ из настроек Keitaro (Администрирование -> API)
KEITARO_API_KEY=replace-with-your-keitaro-api-key
# Таймаут запросов к Keitaro, секунды
KEITARO_TIMEOUT=30
# Строка подключения к БД: по умолчанию SQLite-файл рядом с проектом
DATABASE_URL=sqlite:///./keitaro.db
